<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_glass"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/widgetProfileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#9AE4FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#F3F8FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/widgetSlotOneText"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_slot"
                android:gravity="bottom|center_horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:textAlignment="center"
                android:textColor="#F6F8FD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widgetSlotTwoText"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_slot"
                android:gravity="bottom|center_horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:textAlignment="center"
                android:textColor="#F6F8FD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widgetSlotThreeText"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_slot"
                android:gravity="bottom|center_horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:textAlignment="center"
                android:textColor="#F6F8FD"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
