<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_focus"
    tools:context=".MainActivity">

    <View
        android:id="@+id/constellationOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/bg_constellation_overlay" />

    <View
        android:id="@+id/notificationDimView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/scrim_dim" />

    <ImageView
        android:id="@+id/fixedBackgroundImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:weightSum="3">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/slotOneCard"
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_glass_slot"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                    <ImageView
                        android:id="@+id/slotOneIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="@null"
                        tools:src="@android:drawable/sym_def_app_icon" />

                    <TextView
                        android:id="@+id/slotOneTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Gmail" />

                    <TextView
                        android:id="@+id/slotOneSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_slot_hint_chip"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:minLines="2"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="未読を確認" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/slotTwoCard"
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_glass_slot"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                    <ImageView
                        android:id="@+id/slotTwoIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="@null"
                        tools:src="@android:drawable/sym_def_app_icon" />

                    <TextView
                        android:id="@+id/slotTwoTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Calendar" />

                    <TextView
                        android:id="@+id/slotTwoSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_slot_hint_chip"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:minLines="2"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="予定を確認" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/slotThreeCard"
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_glass_slot_discovery"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                    <ImageView
                        android:id="@+id/slotThreeIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="@null"
                        tools:src="@android:drawable/sym_def_app_icon" />

                    <TextView
                        android:id="@+id/slotThreeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Train Times" />

                    <TextView
                        android:id="@+id/slotThreeSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_slot_hint_chip"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:minLines="2"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="経路を確認" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="34dp"
                android:background="#52D4AF37" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="@string/home_anchor_label_short"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/anchorOneCard"
                android:layout_width="match_parent"
                android:layout_height="98dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_anchor_slot"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/anchorOneIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@null"
                    tools:src="@android:drawable/sym_def_app_icon" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/anchorOneTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/text_primary"
                        android:textSize="1sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/anchorOneSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Chrome" />
                </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.85" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openAllAppsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:text="@string/home_app_drawer_button"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconGravity="textStart"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/text_secondary" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:orientation="vertical">

        <TextView
            android:id="@+id/greetingText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/headlineText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/subheadlineText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/heroMetricsText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/modeLabelText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/visualSummaryText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/signalSummaryText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/coldStartStatusText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/ambientStatusText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/widgetHostSectionTitle"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/widgetHostStatusText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/notificationSummaryText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/notificationPromptText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/profileChip"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/visualModeChip"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:id="@+id/widgetHostContainer"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickSetupButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/migrationInsightButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/benefitDashboardButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/widgetTrialButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rollbackHomeButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectBackgroundButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationSummaryButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationAccessButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/technicalStatusButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />
    </LinearLayout>
</FrameLayout>
