<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_focus"
    tools:context=".MainActivity">

    <View
        android:id="@+id/constellationOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/bg_constellation_overlay" />

    <View
        android:id="@+id/notificationDimView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/scrim_dim" />

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/slotOneCard"
                android:layout_width="0dp"
                android:layout_height="176dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glass_slot"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/slotOneIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        tools:src="@android:drawable/sym_def_app_icon" />

                    <TextView
                        android:id="@+id/slotOneTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:maxLines="2"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Gmail" />

                    <TextView
                        android:id="@+id/slotOneSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="4"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="返信が必要なメールを開く" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/slotTwoCard"
                android:layout_width="0dp"
                android:layout_height="176dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glass_slot"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/slotTwoIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        tools:src="@android:drawable/sym_def_app_icon" />

                    <TextView
                        android:id="@+id/slotTwoTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:maxLines="2"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Calendar" />

                    <TextView
                        android:id="@+id/slotTwoSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="4"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="次の予定を確認" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/slotThreeCard"
                android:layout_width="0dp"
                android:layout_height="176dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glass_slot_discovery"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/slotThreeIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        tools:src="@android:drawable/sym_def_app_icon" />

                    <TextView
                        android:id="@+id/slotThreeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:maxLines="2"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Train Times" />

                    <TextView
                        android:id="@+id/slotThreeSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="4"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="発見枠 / 乗換を先読み" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/anchorOneCard"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="34dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_anchor_slot"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/anchorOneIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@null"
                    tools:src="@android:drawable/sym_def_app_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/anchorOneTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_anchor_label"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/anchorOneSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Chrome" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:orientation="vertical">

        <TextView
            android:id="@+id/greetingText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/headlineText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/subheadlineText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/heroMetricsText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/modeLabelText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/visualSummaryText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/signalSummaryText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/coldStartStatusText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/ambientStatusText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/widgetHostSectionTitle"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/widgetHostStatusText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/notificationSummaryText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/notificationPromptText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/profileChip"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/visualModeChip"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:id="@+id/widgetHostContainer"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openAllAppsButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickSetupButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/migrationInsightButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/benefitDashboardButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/widgetTrialButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rollbackHomeButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectBackgroundButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationSummaryButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationAccessButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/technicalStatusButton"
            android:layout_width="1dp"
            android:layout_height="1dp" />
    </LinearLayout>
</FrameLayout>
