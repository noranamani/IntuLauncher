<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="0"
                android:endColor="#122438"
                android:startColor="#55263F57" />
            <stroke
                android:width="1dp"
                android:color="#55FFB778" />
        </shape>
    </item>
    <item
        android:left="14dp"
        android:top="-6dp">
        <rotate android:fromDegrees="45" android:toDegrees="45">
            <shape android:shape="rectangle">
                <size
                    android:width="18dp"
                    android:height="18dp" />
                <solid android:color="#3A31455F" />
            </shape>
        </rotate>
    </item>
</layer-list>
