<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <gradient
                android:angle="315"
                android:endColor="#13263F"
                android:startColor="#3ED4AF37" />
            <stroke
                android:width="2dp"
                android:color="#D4AF37" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="270"
                android:endColor="#2213263F"
                android:startColor="#44FFF2BF" />
        </shape>
    </item>
</layer-list>
